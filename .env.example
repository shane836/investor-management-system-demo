# Supabase → Settings → API Keys → Publishable and secret API keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used ONLY to send LP invites from /admin. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Where the portal is hosted (used in invite / magic-link emails)
NEXT_PUBLIC_SITE_URL=

# Auth setup command only: sender on a verified Resend domain (not a secret).
SUPABASE_SMTP_SENDER_EMAIL=
# Management credentials default to Keychain; optional .env.local/CI overrides.
SUPABASE_ACCESS_TOKEN=
RESEND_API_KEY=

# Render deployment command only. API key defaults to Keychain investor-portal-demo/render-api-key.
RENDER_API_KEY=
# Optional: select a workspace if your key can access more than one.
RENDER_OWNER_ID=
# Optional: defaults to https://ims.example.com (must be HTTPS).
RENDER_SITE_URL=

# Branding
NEXT_PUBLIC_FIRM_NAME=
NEXT_PUBLIC_IR_EMAIL=
